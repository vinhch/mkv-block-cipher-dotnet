<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- clear: ignore machine-global sources so restore never depends on a private feed. A single source
       also means central package management needs no source mapping. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
