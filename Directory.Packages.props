<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- xunit.v3 runs on Microsoft.Testing.Platform directly, so no Microsoft.NET.Test.Sdk (VSTest) reference. -->
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="coverlet.MTP" Version="10.1.1" />
    <PackageVersion Include="GitHubActionsTestLogger" Version="3.0.5" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <!-- Stays on the major of the SDK in global.json; the ignore rule in dependabot.yml keeps Dependabot off the next major. -->
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.404" />
  </ItemGroup>
</Project>
